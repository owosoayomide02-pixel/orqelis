# Orqelis V1 — never commit real secrets.
# Copy to .env and replace CHANGE_ME values.

# Database
# Local Docker: postgresql+asyncpg://orqelis:orqelis@localhost:5432/orqelis
# Tests / offline: sqlite+aiosqlite:///./orqelis.db
DATABASE_URL=sqlite+aiosqlite:///./orqelis.db

# Redis (optional in V1; used for rate-limit/event coordination when set)
REDIS_URL=

# Auth / crypto — use long random values in any shared environment
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_MINUTES=10080
ENCRYPTION_KEY=CHANGE_ME

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
ENVIRONMENT=development
AUTO_MIGRATE=true
APP_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
COOKIE_SECURE=false

# Rate limits
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20

# Email — leave empty to log verification/reset links in development
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Orqelis <noreply@localhost>
EMAIL_BACKEND=log

# AI gateway — never expose these to browsers or the endpoint agent.
# Groq: AI_PROVIDER=groq, AI_BASE_URL=https://api.groq.com/openai/v1, AI_MODEL=openai/gpt-oss-20b
AI_PROVIDER=heuristic
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
OPENAI_API_KEY=

# Founder bootstrap (development only). Leave empty in production.
# Must be a normal domain (not @localhost or .test) or login validation fails.
FOUNDER_EMAIL=founder@example.com
FOUNDER_PASSWORD=founderpass1

# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# Public API the dashboard prints in enroll commands (also accepted as PUBLIC_API_URL)
# PUBLIC_API_URL=https://api.example.com

# --- Hosted deploy ---
# Website (Netlify, apps/web): NEXT_PUBLIC_APP_URL, NEXT_PUBLIC_API_URL (Render API)
# API (Render): ENVIRONMENT=production COOKIE_SECURE=true
#   DATABASE_URL=postgresql+asyncpg://...
#   CORS_ORIGINS=https://YOUR-SITE.netlify.app
#   APP_BASE_URL=https://YOUR-SITE.netlify.app
#   PUBLIC_API_URL=https://YOUR-API.onrender.com
#   JWT_SECRET and ENCRYPTION_KEY must be long random values (not CHANGE_ME)
