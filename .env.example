# Orqelis V1 — never commit real secrets.
# Copy to .env and replace CHANGE_ME values.

# Database
# Local Docker: postgresql+asyncpg://orqelis:orqelis@localhost:5432/orqelis
# Tests / offline: sqlite+aiosqlite:///./orqelis.db
DATABASE_URL=sqlite+aiosqlite:///./orqelis.db

# Redis (optional in V1; used for rate-limit/event coordination when set)
REDIS_URL=

# Auth / crypto — use long random values in any shared environment
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_MINUTES=10080
ENCRYPTION_KEY=CHANGE_ME

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
ENVIRONMENT=development
AUTO_MIGRATE=true
APP_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
COOKIE_SECURE=false

# Rate limits
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20

# Email — leave empty to log verification/reset links in development
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Orqelis <noreply@localhost>
EMAIL_BACKEND=log

# AI gateway — never expose these to browsers or the endpoint agent.
# Groq: AI_PROVIDER=groq, AI_BASE_URL=https://api.groq.com/openai/v1, AI_MODEL=openai/gpt-oss-20b
AI_PROVIDER=heuristic
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_MODEL_LIGHT=
AI_MODEL_HEAVY=
OPENAI_API_KEY=

# Web asset Hunter scanner
# local = ProjectDiscovery tools on the API host / API Docker image (Option A)
# remote = standalone scanner-service VM (Option B — Oracle/etc, not Render)
# mock = deterministic local findings (tests / Windows preview without tools)
# docker = legacy disposable Kali container (SCANNER_DOCKER_IMAGE)
SCANNER_MODE=local
SCANNER_DOCKER_IMAGE=orqelis-scanner:latest
SCANNER_SERVICE_URL=
SCANNER_INTERNAL_TOKEN=
SCAN_TIMEOUT_TOTAL_S=600
SCAN_QUOTA_PER_ORG_MONTHLY=50
DNS_VERIFY_RATE_LIMIT_SECONDS=30
DNS_VERIFY_STUB=false

# Founder admin — optional Supabase Auth (apps/admin on admin subdomain)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Founder bootstrap (development only). Leave empty in production.
# Must be a normal domain (not @localhost or .test) or login validation fails.
FOUNDER_EMAIL=founder@example.com
FOUNDER_PASSWORD=founderpass1

# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# Static/desktop export: ORQELIS_STATIC_EXPORT=1 npm run build (apps/web)
# Public API the dashboard prints in enroll commands (also accepted as PUBLIC_API_URL)
# PUBLIC_API_URL=https://api.example.com

# --- Hosted deploy (see DEPLOY.md) ---
# Website (Vercel, Root Directory = apps/web):
#   NEXT_PUBLIC_APP_URL=https://YOUR-APP.vercel.app
#   NEXT_PUBLIC_API_URL=https://YOUR-API.onrender.com
# Admin (admin.<domain>): NEXT_PUBLIC_SUPABASE_* + SUPABASE_SERVICE_ROLE_KEY
# API (Render Blueprint / render.yaml): ENVIRONMENT=production COOKIE_SECURE=true
#   DATABASE_URL=postgresql+asyncpg://...
#   CORS_ORIGINS=https://YOUR-APP.vercel.app,https://admin.YOUR-DOMAIN
#   APP_BASE_URL=https://YOUR-APP.vercel.app
#   ADMIN_BASE_URL=https://admin.YOUR-DOMAIN
#   PUBLIC_API_URL=https://YOUR-API.onrender.com
#   JWT_SECRET and ENCRYPTION_KEY must be long random values (not CHANGE_ME)
#   AI_PROVIDER / AI_API_KEY / AI_BASE_URL / AI_MODEL / AI_MODEL_LIGHT / AI_MODEL_HEAVY
#   SCANNER_MODE=local (tools in api.Dockerfile — Option A)
#   SCANNER_MODE=remote + SCANNER_SERVICE_URL + SCANNER_INTERNAL_TOKEN (Option B VM)
#   SCANNER_MODE=mock for local Windows preview without ProjectDiscovery binaries
#   SCANNER_MODE=docker only if using the separate Kali scanner image
